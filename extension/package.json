{
  "name": "td-opencode-plugin-status",
  "version": "0.5.2",
  "private": true,
  "description": "OpenChamber rail panel that shows what td-opencode-plugin configured and its latest model check.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "package.json",
    "panel/index.html",
    "panel/main.js",
    "icon.svg"
  ],
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "check": "openchamber-guest-check ."
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "td-fuelix-status",
    "name": "FueliX status",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "filesystem": ["~/.td-opencode-plugin/status/*.json"]
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@openchamber/sdk": "2.7.0",
    "@types/bun": "1.3.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  }
}

{
  "name": "td-opencode-plugin-status",
  "version": "0.1.0",
  "private": true,
  "description": "OpenChamber extension for td-opencode-plugin: plugin setup report and execution guards.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "package.json",
    "panel/index.html",
    "panel/main.js",
    "panel/status.html",
    "panel/status.js",
    "service/main.js",
    "icon.svg"
  ],
  "scripts": {
    "build": "bun run build:panel && bun run build:status && bun run build:service",
    "build:panel": "openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:status": "openchamber-guest-bundle panel/status.ts panel/status.js",
    "build:service": "openchamber-guest-bundle --node service/main.ts service/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test",
    "check": "openchamber-guest-check ."
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "td-fuelix-status",
    "name": "TD-Plugin extension",
    "icon": "icon.svg",
    "contributes": {
      "panel": {
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "panel/status.html",
        "title": "TD-Plugin guards",
        "height": 48,
        "requiresProject": false
      },
      "capabilities": [
        "model",
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "provides": [
          "opencode"
        ]
      },
      "filesystem": [
        "~/.td-opencode-plugin/status/*.json"
      ]
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@openchamber/sdk": "2.7.0",
    "@types/bun": "1.3.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  }
}

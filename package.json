{
  "name": "td-opencode-plugin",
  "version": "0.5.1",
  "private": true,
  "description": "OpenCode V2 plugin for TELUS Digital: FueliX model catalog, secure key handling, and accurate usage.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "data",
    "index.ts",
    "src",
    "extension/icon.svg",
    "extension/panel/index.html",
    "extension/panel/main.js",
    "extension/plugin/index.js"
  ],
  "scripts": {
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 180000",
    "typecheck": "tsc --noEmit",
    "build": "bun run extension:build && bun run plugin:build",
    "plugin:build": "bun scripts/build-extension-plugin.ts",
    "plugin:check": "bun scripts/build-extension-plugin.ts --check",
    "extension:build": "cd extension && bun run build",
    "extension:typecheck": "cd extension && bun run typecheck",
    "extension:test": "cd extension && bun run test",
    "extension:check": "bun run plugin:check && cd extension && bun run check && bun node_modules/@openchamber/sdk/scripts/check-guest.ts ..",
    "doctor": "bun scripts/doctor.ts",
    "catalog": "bun scripts/build-catalog.ts"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "td-fuelix-status",
    "name": "FueliX status",
    "icon": "extension/icon.svg",
    "contributes": {
      "panel": {
        "entry": "extension/panel/index.html"
      },
      "filesystem": [
        "~/.td-opencode-plugin/status/*.json"
      ],
      "opencodePlugin": "extension/plugin"
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.32",
    "@types/bun": "1.3.0",
    "typescript": "5.9.3"
  }
}
